# Brushfall server settings. Copy to `.env` next to docker-compose.yml and edit.
# Everything here is optional, and you can also use DATA_DIR/brushfall.config.json instead.
# Environment variables win over the config file.

# --- Your world -------------------------------------------------------------
# The setup page (/admin, on the first start) names your world and chooses who may join; change them later in
# Studio Desk > Settings. Set one of these here only to lock it: the Studio Desk then shows it with a lock.
# SERVER_NAME=The Rivera Family Studio
# MOTD=Welcome, painter! Be kind, be brave, and leave the world more colorful than you found it.
# Who can make an account (default approval):
#   approval = anyone can ask, you approve them in the Studio Desk (invite links skip the wait)
#   invite   = only people with an invite link (make them in the Studio Desk or `brushfall invite create`)
#   open     = anyone (only for a private home network; refused on a server the internet can reach)   closed = nobody new
# REGISTRATION=approval
# Chat for accounts without their own setting (default filtered): full | filtered | presets | off
# DEFAULT_CHAT_MODE=filtered
# Players per realm (default 0 = unlimited). Extra players wait in a queue. e.g. 20, or pve:60,hardcore:30
# Easier: leave this unset and set it in Studio Desk -> Settings (live, no restart). Set here, it is locked there.
# MAX_PLAYERS=20
# DAY_CYCLE_MINUTES=120     (length of a day and night; 0 = always daytime)
# JOIN_NOTICES=all          (who hears when a hero arrives: all | family | off)
# CHECKINS=on               (the tea-break "How's it going?" check-in)

# Sign-up puzzle against bots: auto (on for internet servers with open/approval sign-ups) | on | off.
# Also in Studio Desk > Settings; setting it here locks that.
# REGISTRATION_CAPTCHA=auto

# Realms to run: pve (friendly) and/or hardcore (permadeath)
ENABLED_REALMS=pve,hardcore

# A linked parent may hang or send back their own child's paintings (off = only Framers and up).
# PARENTS_HANG_CHILD_ART=on

# --- First admin -------------------------------------------------------------
# Leave these out: on the first start, open /admin and the setup page makes your admin account
# (it asks for the one-time code from `docker compose exec brushfall brushfall setup-code`).
# Only for setups without a browser: set both before the first start, then delete them.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# --- Network ----------------------------------------------------------------
# Port on this computer (inside the container it is always 8080).
BRUSHFALL_PORT=8080
# The address players use, e.g. https://brushfall.example.com
PUBLIC_URL=
# Built-in HTTPS for home networks: self-signed (each device accepts a one-time warning),
# or your own certificate files (paths inside the container, e.g. under /data/tls).
TLS=
# TLS_CERT=/data/tls/fullchain.pem
# TLS_KEY=/data/tls/privkey.pem
# Set to 1 when running behind Caddy, Cloudflare Tunnel or Tailscale.
TRUST_PROXY=0

# --- Reaching it from outside your home (pick one) ---------------------------
# Cloudflare Tunnel (docker compose --profile tunnel up -d): token from the Cloudflare dashboard.
TUNNEL_TOKEN=
# Tailscale (docker compose --profile tailscale up -d): auth key from the Tailscale admin console.
TS_AUTHKEY=
TS_HOSTNAME=brushfall
# tailscale-serve.json = only devices on your tailnet; tailscale-funnel.json = public HTTPS (Funnel)
TS_SERVE_FILE=tailscale-serve.json
# Caddy (docker compose --profile https up -d): your domain, pointing at this machine.
BRUSHFALL_DOMAIN=

# --- Backups ----------------------------------------------------------------
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# --- Getting bug reports ----------------------------------------------------
# Reports always land in the Studio Desk inbox (/admin, Reports tab). Optionally get pinged too:
# Phone push (easiest): install the ntfy app, subscribe to a hard-to-guess topic, then:
#   REPORT_WEBHOOK_URL=https://ntfy.sh/brushfall-rivera-7k3q
# Discord or Slack: paste the channel's incoming-webhook URL instead.
REPORT_WEBHOOK_URL=
# auto (default) | discord | slack | ntfy | json
REPORT_WEBHOOK_KIND=auto
# Email: smtp(s)://user:password@host:port  (Gmail: smtps://you%40gmail.com:APP-PASSWORD@smtp.gmail.com:465)
SMTP_URL=
REPORT_EMAIL_TO=
REPORT_EMAIL_FROM=

# --- Supporting Brushfall ---------------------------------------------------
# Link to support the Brushfall project (shown gently on the login screen and About panel).
DONATE_URL_PROJECT=https://github.com/sponsors/Twelve47Studios
# Optional: your own "help keep this server running" link. Leave empty to hide it.
DONATE_URL_HOST=

# --- Updates and forwarding -----------------------------------------------
# Update channel: stable (tested releases) or early (every change, may be rough).
# Studio Desk -> Settings -> Updates overrides this.
UPDATE_CHANNEL=stable
# A custom update feed that wins over the channel. Leave empty.
UPDATE_FEED_URL=
# Optional: a GitHub token so update checks never run out. GitHub allows 60 checks an hour per internet address,
# shared with every other server and computer on your network; a token gives this server its own 5,000.
# Make one at github.com/settings/tokens (fine-grained, "Public repositories (read-only)", no other permissions).
UPDATE_GITHUB_TOKEN=
# Optional public issue tracker; adds an "Open a public issue instead" button for reports.
PUBLIC_ISSUES_URL=https://github.com/Twelve47Studios/brushfall_release/issues/new

# --- Image ------------------------------------------------------------------
# latest (the newest release), early (every early build), or pin a version (e.g. 0.2.0).
BRUSHFALL_TAG=latest
